# =============================================================================
# RUN — entorno de TEST / QA comercial (PLANTILLA · sin valores reales)
# Copiar a .env.test o .env.local para QA aislado. NUNCA valores productivos.
#
# Objetivo: con Supabase local (supabase start / db reset) o un proyecto Supabase
# EXCLUSIVO de test, correr el recorrido comercial sin tocar datos reales. El
# servidor bloquea escrituras si la base es la productiva (writeGuard).
# =============================================================================

APP_ENV=test

# Sitio de test/preview (no run72.app productivo).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase LOCAL (supabase start) ---
# supabase start imprime estos valores; o usar un proyecto Supabase de test.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- MercadoPago SANDBOX (nunca productivo) ---
MP_SANDBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# --- Correo de test / destinatario controlado ---
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_NOTIFY=
CONTACT_FROM_EMAIL=
# Casilla controlada para verificar recepción en el QA.
LEADS_NOTIFICATION_EMAIL=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Runit (opcional en QA) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
