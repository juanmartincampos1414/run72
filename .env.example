# =============================================================================
# RUN — variables de entorno (PLANTILLA · sin valores reales)
# Copiar a .env.local y completar. NUNCA subir secretos al repo, logs ni capturas.
#
# Ambientes: Local · Test · Preview · Production.
#   - Local / Test: Supabase local (supabase start) o un proyecto Supabase EXCLUSIVO
#     de test. Pagos SOLO sandbox. Fuera de producción, el servidor BLOQUEA
#     escrituras si la base configurada es la productiva (writeGuard, fail-closed).
#   - Preview / Production: variables separadas en Vercel. Preview debe apuntar al
#     proyecto de test, nunca al productivo.
# =============================================================================

# Marca de ambiente de la app (informativo). En Vercel se usa VERCEL_ENV.
APP_ENV=development

# URL pública del sitio (canonical sin parámetros).
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- MercadoPago ---
# Producción: token productivo (también puede estar en la tabla `config`).
MP_ACCESS_TOKEN=
# Preview / Test / Local: credencial SANDBOX (empieza con TEST-). Fuera de prod se
# usa ESTA y se rechaza cualquier token productivo.
MP_SANDBOX_ACCESS_TOKEN=
# Clave pública de MP (checkout).
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Secreto para validar la firma del webhook de MP (obligatorio para procesar pagos).
MP_WEBHOOK_SECRET=

# --- Correo (Resend) ---
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_NOTIFY=
CONTACT_FROM_EMAIL=
LEADS_NOTIFICATION_EMAIL=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Runit (IA) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Admin / Hub ---
ADMIN_EMAILS=
HUB_VAULT_KEY=
